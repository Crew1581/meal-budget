APP_ENVIRONMENT=local
# Относительные пути отсчитываются от корня проекта, не от cwd.
CATALOG_PATH=data/5ka-products.json
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Пример проверен по официальной документации 2026-10-11; модель настраивается отдельно.
DEEPSEEK_MODEL=deepseek-flash
# disabled / enabled / omit (для моделей без параметра thinking).
DEEPSEEK_THINKING=enabled
# Применяется только с thinking=enabled: low / high / max.
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_CONNECT_TIMEOUT=10
DEEPSEEK_READ_TIMEOUT=60
DEEPSEEK_WRITE_TIMEOUT=10
DEEPSEEK_POOL_TIMEOUT=10
DEEPSEEK_MAX_OUTPUT_TOKENS=16384
DEEPSEEK_MAX_RESPONSE_BYTES=262144
GENERATION_TOTAL_TIMEOUT=180
# Закрытый доступ разработчика; токен отдельный от DEEPSEEK_API_KEY, не для Flutter.
GENERATION_HTTP_ENABLED=false
# PostgreSQL; URL с credentials передавать через защищенное окружение, не argv/логи.
# Перед включением HTTP выполнить python -m meal_budget.migrate_jobs apply.
GENERATION_JOBS_DATABASE_URL=
GENERATION_JOBS_POOL_SIZE=4
GENERATION_JOBS_DB_TIMEOUT=5
# Только для локального Compose; пароль задайте через окружение, не коммитьте.
POSTGRES_DB=meal_budget
POSTGRES_USER=meal_budget
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# Ожидающие задания (отдельно от одного активного), от 1 до 100.
GENERATION_JOBS_QUEUE_LIMIT=4
# TTL после completed/failed; queued/running не удаляются.
GENERATION_JOBS_RETENTION_SECONDS=86400
GENERATION_JOBS_CLEANUP_INTERVAL=60
GENERATION_ACCESS_TOKEN=token
# Продуктовая настройка ежедневных диапазонов КБЖУ, не медицинская норма.
GENERATION_NUTRITION_TOLERANCE=0.10
